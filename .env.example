# =========================================================
# Sentix AI — Environment variables template
# =========================================================
# 1. Copy this file to `.env` in the project root:
#        cp .env.example .env
# 2. Fill in real values in `.env` (NEVER commit `.env`).
# 3. `.env` is already listed in .gitignore.
# =========================================================

# ---- Hugging Face (optional; only for private/gated models or higher rate limits) ----
HUGGINGFACE_HUB_TOKEN=

# ---- Model configuration ----
SENTIMENT_MODEL_PATH=tabularisai/multilingual-sentiment-analysis

# ---- Placeholders for future integrations (uncomment when actually used) ----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=           # SERVER-SIDE ONLY
# SUPABASE_URL=
# SUPABASE_ANON_KEY=           # client-safe ONLY if RLS is enabled
# SUPABASE_SERVICE_ROLE_KEY=   # SERVER-SIDE ONLY
# MONGO_URI=
# DATABASE_URL=
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# JWT_SECRET=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
